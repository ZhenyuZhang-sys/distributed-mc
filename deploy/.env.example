# 复制成 .env 再改：cp .env.example .env（.env 有密码，不要提交）。说明见 docs/deploy.md。

# 阅读 https://aka.ms/MinecraftEULA 后，由运行服务器的人自己改成 TRUE
EULA=FALSE

# 必填：这台服务器的公网 IP 或域名。玩家的 worker 按这个地址连 coordinator
PUBLIC_HOST=

# 必填：RCON 密码（只在容器里用）。生成：python3 -c 'import secrets; print(secrets.token_hex(24))'
RCON_PASSWORD=

# 游戏端口、coordinator 端口（两个都要在防火墙上放行 TCP）
MC_PORT=25565
COORD_PORT=25580
# 对外端口和 COORD_PORT 不一样时（路由器端口转发）才设
# COORD_PUBLIC_PORT=

# 正版验证，正式部署保持 TRUE
ONLINE_MODE=TRUE

# 自动找需求、调度开关（docs/config.md）
MCD_DEMAND=on
MCD_FEATURES=territory,deadline,throughput
# 找需求往外多看几圈（docs/config.md 的 demandLookahead）
MCD_LOOKAHEAD=16
# 其他 coordinator 配置（docs/config.md），空格分隔，不要和上面已有的 -D 重复。
# 扫描预算 2000 微秒：11-09 同 2 核、1 个 4 核 donor 烟花直飞 A/B，卡住 17.2% → 3.8%（代码默认 500）
MCD_JVM_EXTRA=-Dmcdonate.demandScanBudgetMicros=2000

# 视距、模拟距离（服务器的 view-distance、simulation-distance）
MC_VIEW_DISTANCE=10
MC_SIMULATION_DISTANCE=6

# 内存（按机器调）。2 核 3 GB 的小机器用 compose.n100.yaml（512M/2G），这两行就不起作用
MC_INIT_MEMORY=1G
MC_MAX_MEMORY=4G

# 世界：名字和 seed（seed 留空是随机）
MC_LEVEL=world
MC_SEED=

# 容器里的服务器进程用哪个用户（和 data/ 目录的属主一致）
MC_UID=1000
MC_GID=1000

# 阅读 https://aka.ms/MinecraftEULA 后，由运行者自行改成 TRUE。
EULA=FALSE

# 用 python3 -c 'import secrets; print(secrets.token_hex(24))' 生成随机密码。
RCON_PASSWORD=

# 首次部署后可在这里填入镜像的 RepoDigest，以固定镜像。
MC_IMAGE=itzg/minecraft-server:java21
MC_CPUS=2
MC_INIT_MEMORY=512M
MC_MAX_MEMORY=1536M
MC_CONTAINER_MEMORY=2304m
MC_BIND_ADDRESS=0.0.0.0
MC_PORT=25565
MC_UID=1000
MC_GID=1000
MC_SEED=424242
MC_LEVEL=world

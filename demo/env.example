COMPOSE_PROJECT=mc-demo
# 阅读 https://aka.ms/MinecraftEULA 后，由运行服务器的人自己改成 TRUE
EULA=FALSE
BIND_IP=<你的 Tailscale IP>
PUBLIC_HOST=<你的 Tailscale IP>
MC_PORT=25590
COORD_PORT=25591
ONLINE_MODE=TRUE
MCD_DEMAND=on
MCD_FEATURES=territory,deadline,throughput
MCD_LOOKAHEAD=16
MCD_JVM_EXTRA=-Dmcdonate.demandScanBudgetMicros=2000 -Dmcdonate.benchLockYaw=-90 -Dmcdonate.benchLockPitch=60 -Dmcdonate.maxConcurrency=8 -Dmcdonate.importTrustDisk=true
MC_VIEW_DISTANCE=6
MC_SIMULATION_DISTANCE=4
MC_INIT_MEMORY=1G
MC_MAX_MEMORY=2G
MC_LEVEL=world
MC_SEED=424242
MC_MOTD=mc-donate demo (1 core)
MC_UID=1002
MC_GID=1002
DEMO_CPUSET=104-105
DEMO_CPUS=1.0
DEMO_MEM=3g

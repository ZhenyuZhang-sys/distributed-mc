      "mcdonate.bench.gametest.FlightGameTest",
      "mcdonate.bench.gametest.ProvenanceGameTest",
      "mcdonate.bench.gametest.RecordGameTest"
    ]
  },
  "mixins": [
    "mcdonate-bench.mixins.json"
  ]

  "environment": "*",
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "mcdonate-common": "=${version}"
  },
  "entrypoints": {
    "main": [
